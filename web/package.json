{
	"name": "paperus-web",
	"version": "0.0.21",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"predev": "node scripts/pdfjs-assets.js",
		"prebuild": "node scripts/pdfjs-assets.js",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"api": "svelte-kit sync && uv run --directory ../server python -m paperus.openapi > src/lib/api/openapi.json && openapi-ts",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "^0.99.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@mdi/js": "^7.4.47",
		"dompurify": "^3.4.17",
		"katex": "0.18.10",
		"marked": "^18.1.3",
		"marked-katex-extension": "^5.1.13",
		"pdfjs-dist": "^6.5.438"
	}
}
