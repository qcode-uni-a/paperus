{
	"name": "paperus-e2e",
	"private": true,
	"type": "module",
	"scripts": {
		"build-web": "npm --prefix ../web run build",
		"test": "npm run build-web && playwright test",
		"test:quick": "playwright test",
		"test:webkit": "npm run build-web && bash scripts/webkit.sh",
		"check": "tsc -p .",
