		"screenshots": "bash scripts/screenshots.sh",
		"demo": "bash scripts/demo.sh"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "^26.6.6",
		"typescript": "^6.0.3"
	}
}
