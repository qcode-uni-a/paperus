# Copy to .env next to compose.yaml and adjust. Paths are folders on this
# machine (created if missing); keep them on storage that is backed up.

# Uploaded files (PDFs and others), stored once per content.
UPLOAD_LOCATION=./library
# The database. Back it up together with UPLOAD_LOCATION.
DB_DATA_LOCATION=./postgres
# Downloaded machine learning models (about 2.5 GB; can be re-downloaded).
MODEL_CACHE_LOCATION=./model-cache

# Version to run: "release" (latest) or e.g. "v0.0.1".
PAPERUS_VERSION=release
# Port on this machine; put a reverse proxy with HTTPS in front of it.
PAPERUS_PORT=8000

# Database credentials. Change the password (letters and digits only).
DB_USERNAME=paperus
DB_PASSWORD=change-me
DB_DATABASE_NAME=paperus

# Shared secret between server and ML service: a long random string,
# e.g. from `openssl rand -hex 32`.
ML_TOKEN=change-me-too

# Sent to Crossref and other metadata services (they ask for one).
CONTACT_EMAIL=

# Session cookies only over HTTPS. Set to false only to try paperus over
# plain HTTP on a local network.
COOKIE_SECURE=true
