# Copy to .env next to compose.yaml and adjust. Paths are folders on this
# machine (created if missing); keep them on storage that is backed up.

# Uploaded files (PDFs and others), stored once per content.
UPLOAD_LOCATION=./library
# The database.
DB_DATA_LOCATION=./postgres
# Backups (Administration → Backups, or `paperus backup create`): best on
# another disk or a network share, so they survive the loss of this one.
BACKUP_LOCATION=./backups
# A readable copy of the library, in folders (only if switched on in
# Administration → Settings → Storage template).
COPY_LOCATION=./library-copy
# Downloaded machine learning models (0.1 to 2.3 GB each; can be
# downloaded again).
MODEL_CACHE_LOCATION=./model-cache

# Version to run: "release" (latest) or e.g. "v0.0.1".
PAPERUS_VERSION=release
# Port on this machine; put a reverse proxy with HTTPS in front of it
# (see docs/operations.md). Only this machine reaches it as given; with the
# proxy on another machine, 8000 alone (Docker's ports pass by firewalls
# such as ufw: then limit who reaches it otherwise).
PAPERUS_PORT=127.0.0.1:8000
# Proxies whose forwarded headers are trusted (default: private networks).
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# The OIDC login's client secret (or enter it in the settings):
# OIDC_CLIENT_SECRET=

# Database credentials. Change the password (letters and digits only).
DB_USERNAME=paperus
DB_PASSWORD=change-me
DB_DATABASE_NAME=paperus

# Shared secret between server and ML service: a long random string,
# e.g. from `openssl rand -hex 32`.
ML_TOKEN=change-me-too
# The ML service on another machine (e.g. a workstation with an NVIDIA
# GPU), instead of the one in compose.yaml; see docs/operations.md.
# ML_URLS='["http://192.168.1.20:3003"]'

# Sent to Crossref and other metadata services (they ask for one); also
# under Administration → Settings → Server, which takes precedence.
CONTACT_EMAIL=

# Session cookies only over HTTPS. Set to false only to try paperus over
# plain HTTP on a local network.
COOKIE_SECURE=true
