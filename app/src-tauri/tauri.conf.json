{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "paperus",
	"identifier": "io.github.qcode-uni-a.paperus",
	"build": {
		"frontendDist": "../start"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Education",
		"shortDescription": "A research library for papers and notes",
		"license": "Apache-2.0",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
